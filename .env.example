# Copy to ".env" and adjust. Values here are safe defaults for local dev.

# --- API ↔ UI ---
COGNITIVE_API_URL=http://127.0.0.1:8000

# --- SQLite (absolute path recommended) ---
# COGNITIVE_DB_PATH=C:/Users/You/cognitive-ai-system/cognitive_system.db

# --- Chroma RAG ---
# CHROMA_PERSIST_DIR=C:/Users/You/cognitive-ai-system/chroma_storage
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Or set full generate URL (base is inferred for /api/tags health check):
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=300

# --- Proactive scheduler (API process) ---
ENABLE_PROACTIVE_SCHEDULER=false
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# --- Voice (optional) ---
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# TTS_RATE=180
